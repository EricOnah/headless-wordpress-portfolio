# Frontend server-side WordPress content API (site root or /wp-json).
WORDPRESS_API_URL=https://cms.ericonah.online

# Contact form delivery. Enter real credentials in Vercel's environment settings.
CONTACT_TO=ericdavid4u@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional bot verification: configure BOTH values and redeploy to enable.
# Register ericonah.online (and www if used) in the Cloudflare Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional footer Lighthouse scores, refreshed during production builds.
# Enable PageSpeed Insights API in Google Cloud. Keep the key server-side.
PAGESPEED_API_KEY=
LIGHTHOUSE_SITE_URL=https://ericonah.online/
